---
---
<div id="now-reading-wrap" class="now-reading-wrap" hidden>
  <div id="now-reading" class="now-reading">
    <button id="now-reading-toggle" class="nr-toggle" type="button" aria-expanded="false" aria-label="Show what I'm reading">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 4h6a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5H2z" />
        <path d="M22 4h-6a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5H22z" />
      </svg>
    </button>
    <img id="now-reading-cover" class="nr-cover" alt="" />
    <a id="now-reading-book" class="nr-book" href="#" target="_blank" rel="noopener"></a>
  </div>
  <span class="nr-tooltip">Here's what I'm reading these days</span>
</div>

<style>
  .now-reading-wrap { position: fixed; bottom: 5.5rem; right: 1.5rem; z-index: 40; transition: bottom 0.3s ease; }
  .now-reading {
    display: flex; align-items: center;
    background: var(--bg); border: 1px solid var(--border); border-radius: 999px;
    overflow: hidden; max-width: 52px; height: 52px;
    transition: max-width 0.3s ease, background 0.3s ease;
  }
  .now-reading-wrap.is-open .now-reading {
    max-width: 340px;
    background: color-mix(in srgb, var(--bg), var(--ink) 8%);
  }
  .nr-toggle {
    flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%;
    background: none; border: none; color: var(--ink); cursor: pointer;
    display: flex; align-items: center; justify-content: center; padding: 0;
  }
  .nr-toggle svg { width: 22px; height: 22px; }
  .nr-tooltip {
    position: absolute; top: 50%; right: 60px; transform: translateY(-50%);
    background: var(--ink); color: var(--bg); font-size: 0.8rem; font-weight: 600;
    padding: 0.4rem 0.75rem; border-radius: 8px; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity 0.2s ease;
  }
  .now-reading-wrap:hover .nr-tooltip { opacity: 1; }
  .now-reading-wrap.is-open .nr-tooltip { display: none; }
  .nr-cover {
    width: 32px; height: 32px; border-radius: 6px; object-fit: cover; flex-shrink: 0;
    margin-left: 0.6rem; opacity: 0; transition: opacity 0.2s ease 0.1s;
  }
  .now-reading-wrap.is-open .nr-cover { opacity: 1; }
  .nr-book {
    padding-right: 1.1rem; margin-left: 0.6rem; color: var(--ink-soft); text-decoration: none;
    font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    opacity: 0; transition: opacity 0.2s ease 0.1s;
  }
  .now-reading-wrap.is-open .nr-book { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .now-reading, .nr-tooltip, .nr-cover, .nr-book { transition: none; }
  }
</style>

<script>
  const ENDPOINT = "https://8oh8dwy5dg.execute-api.eu-north-1.amazonaws.com/default/goodreads-currently-reading";
  const wrap = document.getElementById("now-reading-wrap")!;
  const toggle = document.getElementById("now-reading-toggle")!;
  const cover = document.getElementById("now-reading-cover") as HTMLImageElement;
  const bookLink = document.getElementById("now-reading-book") as HTMLAnchorElement;

  toggle.addEventListener("click", () => {
    const isOpen = wrap.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  async function update() {
    try {
      const res = await fetch(ENDPOINT);
      const json = await res.json();
      if (!json.ok || !json.data.isReading) {
        wrap.hidden = true;
        return;
      }
      bookLink.textContent = `${json.data.title} — ${json.data.author}`;
      bookLink.href = json.data.link || "#";
      cover.hidden = !json.data.coverUrl;
      if (json.data.coverUrl) cover.src = json.data.coverUrl;
      wrap.hidden = false;
    } catch {
      wrap.hidden = true;
    }
  }

  update();
  setInterval(update, 60000);
</script>